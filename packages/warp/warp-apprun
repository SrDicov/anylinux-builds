#!/bin/sh
SELF_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
export PATH="$SELF_DIR:$PATH"
WARP_SVC="$SELF_DIR/warp-svc"
WARP_CLI="$SELF_DIR/warp-cli"
[ -x "$WARP_SVC" ] || WARP_SVC="warp-svc"
[ -x "$WARP_CLI" ] || WARP_CLI="warp-cli"

NAME="$(basename "$0")"

# Drop-in compatibility when symlinked as warp-cli
if [ "$NAME" = "warp-cli" ]; then
    exec "$WARP_CLI" "$@"
fi

# Drop-in compatibility when symlinked as warp-svc
if [ "$NAME" = "warp-svc" ]; then
    mkdir -p /run/cloudflare-warp /var/lib/cloudflare-warp 2>/dev/null || true
    exec "$WARP_SVC" "$@"
fi

case "${1:-}" in
    svc)
        shift
        mkdir -p /run/cloudflare-warp /var/lib/cloudflare-warp 2>/dev/null || true
        exec "$WARP_SVC" "$@"
        ;;
    cli)
        shift
        exec "$WARP_CLI" "$@"
        ;;
    shell)
        shift
        exec /bin/sh "$@"
        ;;
    -v|-V|--version)
        exec "$WARP_CLI" --version
        ;;
    *)
        if [ $# -gt 0 ]; then
            exec "$WARP_CLI" "$@"
        else
            echo "Cloudflare WARP AppImage"
            echo "Usage:"
            echo "  $0 svc [args...]          Start WARP daemon"
            echo "  $0 cli [args...]          Run warp-cli"
            echo "  $0 shell                  Open interactive shell"
            echo "  $0 --version              Show warp-cli version"
            echo ""
            echo "Drop-in symlink for rotator.py:"
            echo "  ln -s \$PWD/WARP.AppImage /usr/local/bin/warp-cli"
            exit 1
        fi
        ;;
esac
